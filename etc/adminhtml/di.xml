<?xml version="1.0"?>
<!--
  Registers the "checkout enabled but endpoint unauthenticated" admin notice.
  @since 1.2.0
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="angeoMcpCheckoutUnauthenticated" xsi:type="string">
                    Angeo\McpCheckout\Model\Message\UnauthenticatedCheckoutNotice
                </item>
            </argument>
        </arguments>
    </type>
</config>
