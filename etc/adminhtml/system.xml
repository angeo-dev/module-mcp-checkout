<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="angeo" translate="label" sortOrder="450">
            <label>Angeo</label>
        </tab>
        <section id="angeo_mcp_checkout" translate="label" type="text" sortOrder="60"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <label>MCP Checkout (AI Agents)</label>
            <tab>angeo</tab>
            <resource>Angeo_McpCheckout::config</resource>

            <group id="general" translate="label" type="text" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Agent Checkout Tools</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><![CDATA[Disabled by default. When enabled, AI agents connected via the
                        Angeo MCP Server can create guest carts and place orders within the limits below.
                        Review every limit before enabling on a store with real payment methods.]]></comment>
                </field>
            </group>

            <group id="limits" translate="label" type="text" sortOrder="20"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Order Limits</label>
                <field id="max_order_total" translate="label comment" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Order Total</label>
                    <validate>validate-zero-or-greater validate-number</validate>
                    <comment><![CDATA[Hard cap on the grand total of agent-placed orders, in the store's
                        <strong>base currency</strong>. Enforced when items are added and again when the order is
                        placed, against final totals including shipping and tax. 0 = no cap (not recommended).]]></comment>
                </field>
                <field id="max_qty_per_item" translate="label" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Quantity per Line Item</label>
                    <validate>validate-greater-than-zero validate-digits</validate>
                    <comment>Applies to the resulting quantity, so repeated additions of the same SKU cannot stack past it.</comment>
                </field>
                <field id="max_cart_items" translate="label" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Line Items per Cart</label>
                    <validate>validate-greater-than-zero validate-digits</validate>
                </field>
                <field id="orders_per_hour" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Orders per Hour (Global)</label>
                    <validate>validate-zero-or-greater validate-digits</validate>
                    <comment>Total agent orders across all connections. 0 = no limit (not recommended).</comment>
                </field>
                <field id="orders_per_hour_per_ip" translate="label comment" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Orders per Hour (per IP)</label>
                    <validate>validate-zero-or-greater validate-digits</validate>
                    <comment><![CDATA[Secondary brake, best-effort. Cloud MCP clients (e.g. Claude) connect from a
                        small pool of provider IPs, so this limit is shared across their users — keep it at or above the
                        global limit and rely on the global cap as the primary control. Behind a CDN or load balancer the
                        value seen here is the proxy's address unless forwarded-header trust is configured, and where it
                        <em>is</em> configured the header is client-supplied. 0 = no limit.]]></comment>
                </field>
            </group>

            <group id="payment" translate="label" type="text" sortOrder="30"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Payment</label>
                <field id="allowed_methods" translate="label comment" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Allowed Payment Method Codes</label>
                    <comment><![CDATA[Comma-separated payment method codes agents may use, e.g.
                        <code>checkmo</code>. Keep offline methods only for demos. The method must also
                        be enabled in Sales &rarr; Payment Methods.]]></comment>
                </field>
            </group>

            <group id="shipping" translate="label" type="text" sortOrder="40"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Shipping</label>
                <field id="allowed_countries" translate="label comment" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Allowed Destination Countries</label>
                    <comment>Comma-separated ISO 3166-1 alpha-2 codes, e.g. NL,DE,BE. Empty = all countries enabled for the store.</comment>
                </field>
            </group>

            <group id="cleanup" translate="label" type="text" sortOrder="50"
                   showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Demo Cleanup</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Auto-cancel Stale Agent Orders (demo only)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><![CDATA[<strong>Destructive. Off by default.</strong> An hourly cron cancels agent orders
                        still unpaid (state: new / pending payment) after the age below. Offline methods such as
                        <code>checkmo</code> stay in that state until you mark them paid, so enabling this on a store
                        taking real agent orders will cancel legitimate ones. Demo and staging deployments only.]]></comment>
                </field>
                <field id="order_age_hours" translate="label" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Cancel After (hours)</label>
                    <validate>validate-greater-than-zero validate-digits</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
        </section>
    </system>
</config>
