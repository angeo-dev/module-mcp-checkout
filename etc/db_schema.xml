<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="angeo_mcp_order_log" resource="default" engine="innodb"
           comment="Angeo MCP Checkout: agent order audit log and rate-limit source">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false"
                identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="remote_ip" length="45" nullable="false"
                comment="Remote IP of the MCP client"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false"
                comment="Sales order entity ID"/>
        <column xsi:type="int" name="quote_id" unsigned="true" nullable="false"
                comment="Quote entity ID"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At (UTC)"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="ANGEO_MCP_ORDER_LOG_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
        <index referenceId="ANGEO_MCP_ORDER_LOG_REMOTE_IP_CREATED_AT" indexType="btree">
            <column name="remote_ip"/>
            <column name="created_at"/>
        </index>
    </table>
</schema>
